NODE_ENV=development
DATABASE_PATH=./data/mc-controller.db
MC_DATA_PATH=./data/servers
# Absolute path on the Docker host. Required in Docker/Dokploy so created Minecraft containers see their files.
MC_DATA_HOST_PATH=/opt/mc-controller/data
PORT_RANGE_START=25565
PORT_RANGE_END=25600
CURSEFORGE_API_KEY=
JWT_SECRET=change_me_to_a_random_secret_string
DOCKER_SOCKET=/var/run/docker.sock
