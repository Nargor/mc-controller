# Copy this file to .env, then edit the values before deployment.
#
# Local without Docker: use `npm run dev` and set MC_RUNTIME=native.
# Docker/Dokploy: docker-compose.yml sets NUXT_MC_RUNTIME=docker automatically.
NODE_ENV=development
MC_RUNTIME=native
# Do not set NUXT_MC_RUNTIME here: compose supplies "docker" while npm run dev
# uses MC_RUNTIME=native above.

# Local native data paths (used by npm run dev).
DATABASE_PATH=./data/mc-controller.db
MC_DATA_PATH=./data/servers

# Docker host data path. REQUIRED when using docker compose/Dokploy because
# Minecraft containers are created by the Docker daemon and need the real host path.
# Choose exactly ONE of the following examples; leave the other one commented.
# Windows Docker Desktop:
MC_DATA_HOST_PATH=D:/work/mc-controller/data
# Linux server / Dokploy:
# MC_DATA_HOST_PATH=/opt/mc-controller/data

# Web panel host binding. 0.0.0.0 means every network interface.
# Example LAN-only binding: WEB_BIND_IP=192.168.1.10
WEB_BIND_IP=0.0.0.0
WEB_PORT=3000

# The host IP used by every Minecraft container created from this controller.
# Use 0.0.0.0 for all interfaces, or the server's LAN/public IP to bind only there.
MC_BIND_IP=0.0.0.0
PORT_RANGE_START=25565
PORT_RANGE_END=25600

# Docker Hub image coordinates, used by docker-compose.prod.yml.
DOCKER_HUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# Optional: required only for CurseForge modpacks / CurseForge file downloads.
CURSEFORGE_API_KEY=

# REQUIRED: replace with a long random value before deployment.
# Generate one in PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_before_deploy

# Docker socket path inside the controller container. Do not change for Docker Desktop/Dokploy.
DOCKER_SOCKET=/var/run/docker.sock
