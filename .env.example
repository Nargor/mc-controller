NODE_ENV=development
MC_RUNTIME=native
DATABASE_PATH=./data/mc-controller.db
MC_DATA_PATH=./data/servers
# Absolute path on the Docker host. Required in Docker/Dokploy so created Minecraft containers see their files.
MC_DATA_HOST_PATH=/opt/mc-controller/data
# Docker-only: web panel host binding and the host IP used by created Minecraft containers.
# Use 0.0.0.0 for every interface, or a specific LAN/public IP to restrict access.
WEB_BIND_IP=0.0.0.0
WEB_PORT=3000
MC_BIND_IP=0.0.0.0
PORT_RANGE_START=25565
PORT_RANGE_END=25600
# Docker Hub deployment image, used by docker-compose.prod.yml
DOCKER_HUB_USERNAME=your-dockerhub-user
IMAGE_TAG=latest
CURSEFORGE_API_KEY=
JWT_SECRET=change_me_to_a_random_secret_string
DOCKER_SOCKET=/var/run/docker.sock
